/* ═══════════════════════════════════════════════════════════════════════
   CRYPTOLEARNING  ·  ACCESO
   Pure Black Spatial  ·  Deep Dark Edition
   ═══════════════════════════════════════════════════════════════════════ */


/* ── VENTANA BASE ───────────────────────────────────────────────────── */
QMainWindow, QWidget#centralwidget {
    background-color: #000000;
}
QFrame { background: transparent; border: none; }


/* ── PANELES ────────────────────────────────────────────────────────── */
QFrame#frame_left  { background-color: #000000; }
QFrame#frame_right { background-color: #000000; }


/* ── CARD PRINCIPAL — profundidad radial ────────────────────────────── */
QFrame#form_card {
    background: qradialgradient(
        cx: 0.50, cy: 0.38, radius: 0.85,
        stop: 0.00  rgba(26, 26, 36, 255),
        stop: 0.55  rgba(15, 15, 22, 255),
        stop: 1.00  rgba( 7,  7, 11, 255)
    );
    border-top:    1px solid rgba(255, 255, 255, 55);
    border-left:   1px solid rgba(255, 255, 255, 30);
    border-right:  1px solid rgba(255, 255, 255, 18);
    border-bottom: 1px solid rgba(255, 255, 255, 12);
    border-radius: 26px;
}


/* ── LÍNEA NARANJA SUPERIOR DE LA CARD ──────────────────────────────── */
QFrame#card_glow_top {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0.00 rgba(255, 106,  0,   0),
        stop:0.25 rgba(255, 106,  0, 120),
        stop:0.50 rgba(255, 160,  0, 255),
        stop:0.75 rgba(255, 106,  0, 120),
        stop:1.00 rgba(255, 106,  0,   0)
    );
    min-height: 1px;
    max-height: 1px;
    border: none;
}


/* ── SEPARADOR INTERIOR ─────────────────────────────────────────────── */
QFrame#separator {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0.00 rgba(255, 255, 255,  0),
        stop:0.50 rgba(255, 255, 255, 28),
        stop:1.00 rgba(255, 255, 255,  0)
    );
    min-height: 1px;
    max-height: 1px;
    border: none;
}


/* ── TÍTULO ─────────────────────────────────────────────────────────── */
QLabel#lbl_titulo {
    color: #FFFFFF;
    font-size: 17px;
    font-weight: 700;
    font-family: "Helvetica Neue", "Segoe UI Semibold", Arial, sans-serif;
    letter-spacing: 3px;
    padding-bottom: 9px;
    border-bottom: 2px solid qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0.00 rgba(255, 106,  0,   0),
        stop:0.30 rgba(255, 106,  0, 160),
        stop:0.50 rgba(255, 180,  0, 255),
        stop:0.70 rgba(255, 106,  0, 160),
        stop:1.00 rgba(255, 106,  0,   0)
    );
    qproperty-alignment: AlignCenter;
}


/* ── SUBTÍTULO ──────────────────────────────────────────────────────── */
QLabel#lbl_subtitulo {
    color: rgba(255, 255, 255, 75);
    font-size: 11px;
    font-family: "Helvetica Neue", "Segoe UI", Arial, sans-serif;
    letter-spacing: 1px;
    qproperty-alignment: AlignCenter;
}


/* ── ETIQUETAS DE CAMPO ─────────────────────────────────────────────── */
QLabel#lbl_f_email,
QLabel#lbl_f_pass {
    color: rgba(255, 140, 0, 170);
    font-size: 9px;
    font-weight: 700;
    font-family: "Helvetica Neue", "Segoe UI", Arial, sans-serif;
    letter-spacing: 2.2px;
    padding-left: 1px;
}


/* ── INPUTS ─────────────────────────────────────────────────────────── */
QLineEdit {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(255, 255, 255,  7),
        stop:1 rgba(255, 255, 255,  3)
    );
    border: 1px solid rgba(255, 255, 255, 16);
    border-bottom: 1px solid rgba(255, 255, 255, 26);
    border-radius: 10px;
    color: rgba(255, 255, 255, 215);
    padding: 10px 14px;
    font-size: 13px;
    font-family: "Helvetica Neue", "Segoe UI", Arial, sans-serif;
    min-height: 20px;
    selection-background-color: rgba(255, 106, 0, 100);
    selection-color: #FFFFFF;
}

QLineEdit:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(255, 255, 255, 11),
        stop:1 rgba(255, 255, 255,  6)
    );
    border: 1px solid rgba(255, 255, 255, 40);
    border-bottom: 1px solid rgba(255, 255, 255, 55);
    color: #FFFFFF;
}

QLineEdit:focus {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(255, 106, 0, 20),
        stop:1 rgba(255,  80, 0,  8)
    );
    border: 1px solid rgba(255, 130, 0, 180);
    border-bottom: 1px solid rgba(255, 160, 0, 240);
    color: #FFFFFF;
}


/* ── BOTÓN PRIMARIO ─────────────────────────────────────────────────── */
QPushButton#Aceptar {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0.0  #FF5E00,
        stop:0.5  #FF8000,
        stop:1.0  #FF5200
    );
    color: #000000;
    font-weight: 800;
    font-size: 11px;
    font-family: "Helvetica Neue", "Segoe UI Semibold", Arial, sans-serif;
    letter-spacing: 3.5px;
    border-radius: 11px;
    border-top:    1px solid rgba(255, 200, 100, 160);
    border-left:   1px solid rgba(255, 200, 100,  80);
    border-right:  1px solid rgba(180,  80,   0,  80);
    border-bottom: 1px solid rgba(160,  60,   0, 120);
    min-height: 48px;
    padding: 0 20px;
}

QPushButton#Aceptar:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0.0  #FF7520,
        stop:0.5  #FFA040,
        stop:1.0  #FF6A18
    );
    border-top:    1px solid rgba(255, 220, 140, 200);
    border-left:   1px solid rgba(255, 220, 140, 100);
    border-right:  1px solid rgba(200, 100,   0,  80);
    border-bottom: 1px solid rgba(180,  80,   0, 120);
    color: #000000;
}

QPushButton#Aceptar:pressed {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0.0  #D94E00,
        stop:0.5  #E06A00,
        stop:1.0  #D04400
    );
    border-top:    1px solid rgba(120,  40,   0,  80);
    border-left:   1px solid rgba(120,  40,   0,  60);
    border-right:  1px solid rgba(255, 180,  80,  40);
    border-bottom: 1px solid rgba(255, 180,  80,  60);
    padding-top: 1px;
}


/* ── BOTÓN REGISTRO (link) ──────────────────────────────────────────── */
QPushButton#btn_ir_registro {
    color: rgba(255, 255, 255, 50);
    background: transparent;
    border: none;
    font-size: 11px;
    font-family: "Helvetica Neue", "Segoe UI", Arial, sans-serif;
    letter-spacing: 0.3px;
    padding: 6px 0;
}
QPushButton#btn_ir_registro:hover  { color: #FF7A00; }
QPushButton#btn_ir_registro:pressed{ color: rgba(255, 122, 0, 160); }


/* ── PIE DE PANTALLA ────────────────────────────────────────────────── */
QLabel#lbl_version {
    color: rgba(255, 255, 255, 18);
    font-size: 9px;
    font-family: "Helvetica Neue", "Segoe UI", Arial, sans-serif;
    letter-spacing: 1.8px;
    qproperty-alignment: AlignCenter;
}

