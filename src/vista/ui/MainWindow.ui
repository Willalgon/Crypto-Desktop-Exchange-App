  <property name="styleSheet">
   <string notr="true">
 /* FONDO NEGRO PURO */
QMainWindow { background-color: #000000; }
QFrame { background: transparent; border: none; }

/* 3- TITULO EN NARANJA PURO */
QLabel#lbl_titulo { 
    color: #FFFFFF; 
    font-size: 32px; 
    font-weight: bold; 
    font-family: 'Inter', 'Roboto', 'sans-serif';
    letter-spacing: 1px;
}

QLabel#lbl_subtitulo { 
    color: #8B94A5; 
    font-size: 16px; 
    font-family: 'Inter', 'Roboto', 'sans-serif';
}

/* 2- BORDES DE RECUADROS NARANJAS */
QLineEdit {
    background-color: #0D1117;
    border: 2px solid #FF6A00; /* Borde naranja permanente */
    border-radius: 8px;
    color: #FFFFFF;
    padding: 18px 20px;
    font-size: 16px;
}
QLineEdit:focus {
    border: 2px solid #FF4500; /* Naranja más intenso al escribir */
    background-color: #161B22;
}

/* 1- BOTÓN INICIAR SESIÓN NARANJA PURO */
QPushButton#Aceptar {
    background-color: #FF6A00; /* Naranja puro sólido */
    color: #000000; /* Texto negro para contraste máximo */
    font-weight: bold;
    font-size: 18px;
    border-radius: 8px;
    padding: 18px;
    letter-spacing: 2px;
}
QPushButton#Aceptar:hover { 
    background-color: #FF4500; /* Naranja más oscuro al pasar el ratón */
}

/* ENLACE INFERIOR */
QPushButton#btn_ir_registro { 
    color: #8B94A5; 
    background: transparent; 
    border: none; 
    font-size: 14px;
}
QPushButton#btn_ir_registro:hover { color: #FF6A00; text-decoration: underline; }
   </string>
