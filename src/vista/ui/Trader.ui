<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>TraderWindow</class>
 <widget class="QMainWindow" name="TraderWindow">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>1440</width><height>900</height></rect>
  </property>
  <property name="windowTitle">
   <string>CryptoLearning — Panel Trader</string>
  </property>

  <property name="styleSheet">
   <string notr="true">

/* ═══════════════════════════════════════════════════════════════════════
   CRYPTOLEARNING  ·  PANEL TRADER
   Apple Spatial Design  ·  Dark Matter Edition
   ═══════════════════════════════════════════════════════════════════════
   Palette:
     Surface-0  #0A0A0B   — void black
     Surface-1  #111113   — deep base
     Surface-2  #18181B   — card ground
     Surface-3  #222226   — raised card
     Surface-4  #2C2C31   — input field
     Divider    rgba(255,255,255,0.06)
     Border     rgba(255,255,255,0.10)
     Border-hi  rgba(255,255,255,0.16)
     Accent     #FF6B00   — CryptoOrange
     Accent-hi  #FF8C2A   — warm highlight
     Green      #34C759   — profit
     Red        #FF3B30   — loss
     Text-pri   rgba(255,255,255,0.92)
     Text-sec   rgba(255,255,255,0.50)
     Text-ter   rgba(255,255,255,0.25)
   ═══════════════════════════════════════════════════════════════════════ */

/* ── BASE ───────────────────────────────────────────────────────────── */
QMainWindow, QWidget#centralwidget {
    background-color: #0A0A0B;
    font-family: "SF Pro Display", "Helvetica Neue", "Segoe UI Variable", Arial, sans-serif;
}
QFrame { background: transparent; border: none; }

/* ── SIDEBAR ────────────────────────────────────────────────────────── */
QFrame#sidebar {
    background-color: #111113;
    border-right: 1px solid rgba(255, 255, 255, 0.06);
}

/* ── LOGO ───────────────────────────────────────────────────────────── */
QLabel#lbl_sidebar_logo {
    color: rgba(255, 255, 255, 0.92);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 2px;
    qproperty-alignment: AlignLeft;
}
QLabel#lbl_sidebar_sub {
    color: #FF6B00;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 1.5px;
    qproperty-alignment: AlignLeft;
}

/* ── SEPARADOR ──────────────────────────────────────────────────────── */
QFrame#sep_sidebar {
    background-color: rgba(255, 255, 255, 0.06);
    min-height: 1px;
    max-height: 1px;
    border: none;
}

/* ── SECCIÓN NAV LABEL ──────────────────────────────────────────────── */
QLabel#lbl_nav_section {
    color: rgba(255, 255, 255, 0.22);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 2px;
    padding-left: 16px;
}

/* ── BOTONES NAV ────────────────────────────────────────────────────── */
QPushButton#btn_nav_mercado,
QPushButton#btn_nav_cartera,
QPushButton#btn_nav_noticias,
QPushButton#btn_nav_historial {
    background: transparent;
    color: rgba(255, 255, 255, 0.45);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.2px;
    border: none;
    border-radius: 10px;
    padding: 10px 14px 10px 14px;
    text-align: left;
}
QPushButton#btn_nav_mercado:hover,
QPushButton#btn_nav_cartera:hover,
QPushButton#btn_nav_noticias:hover,
QPushButton#btn_nav_historial:hover {
    background: rgba(255, 255, 255, 0.05);
    color: rgba(255, 255, 255, 0.80);
}
QPushButton#btn_nav_mercado:pressed,
QPushButton#btn_nav_cartera:pressed,
QPushButton#btn_nav_noticias:pressed,
QPushButton#btn_nav_historial:pressed {
    background: rgba(255, 107, 0, 0.10);
    color: #FF8C2A;
}
QPushButton#btn_nav_salir {
    background: transparent;
    color: rgba(255, 80, 80, 0.45);
    font-size: 12px;
    font-weight: 500;
    border: none;
    border-radius: 10px;
    padding: 10px 14px 10px 14px;
    text-align: left;
}
QPushButton#btn_nav_salir:hover {
    background: rgba(255, 60, 60, 0.07);
    color: rgba(255, 100, 100, 0.80);
}

/* ── AVATAR USUARIO ─────────────────────────────────────────────────── */
QFrame#user_pill {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
}
QLabel#lbl_user_name {
    color: rgba(255, 255, 255, 0.70);
    font-size: 11px;
    font-weight: 500;
}
QLabel#lbl_user_role {
    color: rgba(255, 107, 0, 0.70);
    font-size: 9px;
    font-weight: 400;
    letter-spacing: 0.5px;
}
QLabel#lbl_user_avatar {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,
        stop:0 #FF6B00, stop:1 #FF3D00);
    color: #000000;
    font-size: 11px;
    font-weight: 700;
    border-radius: 10px;
    qproperty-alignment: AlignCenter;
}

/* ── ÁREA PRINCIPAL ─────────────────────────────────────────────────── */
QFrame#main_area {
    background-color: #0A0A0B;
}

/* ── TOPBAR ─────────────────────────────────────────────────────────── */
QFrame#topbar {
    background-color: rgba(10, 10, 11, 0.85);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}
QLabel#lbl_topbar_breadcrumb {
    color: rgba(255, 255, 255, 0.28);
    font-size: 11px;
    font-weight: 400;
}
QLabel#lbl_topbar_breadcrumb_sep {
    color: rgba(255, 255, 255, 0.15);
    font-size: 11px;
}
QLabel#lbl_topbar_breadcrumb_active {
    color: rgba(255, 255, 255, 0.55);
    font-size: 11px;
    font-weight: 500;
}

/* ── BADGE LIVE ─────────────────────────────────────────────────────── */
QLabel#lbl_live_dot {
    background: #34C759;
    border-radius: 4px;
    min-width: 8px;
    max-width: 8px;
    min-height: 8px;
    max-height: 8px;
}
QLabel#lbl_live_text {
    color: rgba(52, 199, 89, 0.80);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.5px;
}

/* ── CARDS ──────────────────────────────────────────────────────────── */
QFrame#card_mercado,
QFrame#card_operacion,
QFrame#card_cartera,
QFrame#card_posiciones,
QFrame#card_noticias,
QFrame#card_historial_ops {
    background-color: #18181B;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 18px;
}

/* ── ACCENT LINE TOP ────────────────────────────────────────────────── */
QFrame#card_accent_mkt,
QFrame#card_accent_op,
QFrame#card_accent_cart,
QFrame#card_accent_pos,
QFrame#card_accent_not,
QFrame#card_accent_hist {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0.00 rgba(255, 107, 0,   0),
        stop:0.30 rgba(255, 107, 0, 160),
        stop:0.50 rgba(255, 160, 0, 255),
        stop:0.70 rgba(255, 107, 0, 160),
        stop:1.00 rgba(255, 107, 0,   0)
    );
    min-height: 1px;
    max-height: 1px;
    border: none;
    border-radius: 0px;
}

/* ── EYEBROW / TÍTULOS CARD ─────────────────────────────────────────── */
QLabel#lbl_ey_mkt, QLabel#lbl_ey_op,
QLabel#lbl_ey_cart, QLabel#lbl_ey_pos,
QLabel#lbl_ey_not, QLabel#lbl_ey_hist {
    color: #FF6B00;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 2.2px;
}
QLabel#lbl_tit_mkt, QLabel#lbl_tit_op,
QLabel#lbl_tit_cart, QLabel#lbl_tit_pos,
QLabel#lbl_tit_not, QLabel#lbl_tit_hist {
    color: rgba(255, 255, 255, 0.92);
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.3px;
}
QLabel#lbl_desc_mkt, QLabel#lbl_desc_op,
QLabel#lbl_desc_cart, QLabel#lbl_desc_pos,
QLabel#lbl_desc_not, QLabel#lbl_desc_hist {
    color: rgba(255, 255, 255, 0.32);
    font-size: 11px;
}

/* ── SEPARADOR INTERNO ──────────────────────────────────────────────── */
QFrame#sep_card {
    background-color: rgba(255, 255, 255, 0.05);
    min-height: 1px;
    max-height: 1px;
    border: none;
}

/* ── KPI CARDS (saldo / patrimonio) ─────────────────────────────────── */
QFrame#kpi_saldo, QFrame#kpi_patrimonio {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 12px;
}
QLabel#lbl_kpi_label_saldo, QLabel#lbl_kpi_label_pat {
    color: rgba(255, 255, 255, 0.35);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 1.8px;
}
QLabel#lbl_kpi_saldo {
    color: #34C759;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.5px;
}
QLabel#lbl_kpi_patrimonio {
    color: rgba(255, 255, 255, 0.88);
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.5px;
}

/* ── ETIQUETAS CAMPO ────────────────────────────────────────────────── */
QLabel#lbl_f_activo, QLabel#lbl_f_tipo,
QLabel#lbl_f_cantidad {
    color: rgba(255, 255, 255, 0.40);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1.5px;
}

/* ── COMBO BOX ──────────────────────────────────────────────────────── */
QComboBox#combo_activo, QComboBox#combo_tipo {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
        stop:0 rgba(255,255,255,8), stop:1 rgba(255,255,255,4));
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-bottom: 1px solid rgba(255, 255, 255, 0.20);
    border-radius: 10px;
    color: rgba(255, 255, 255, 0.88);
    padding: 10px 14px;
    font-size: 13px;
    min-height: 20px;
    selection-background-color: rgba(255, 107, 0, 0.18);
    selection-color: #FF8C2A;
}
QComboBox#combo_activo:hover, QComboBox#combo_tipo:hover {
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.26);
    color: #FFFFFF;
}
QComboBox#combo_activo:focus, QComboBox#combo_tipo:focus {
    border: 1px solid rgba(255, 130, 0, 0.65);
    color: #FFFFFF;
}
QComboBox#combo_activo::drop-down, QComboBox#combo_tipo::drop-down {
    border: none;
    padding-right: 12px;
}
QComboBox QAbstractItemView {
    background: #141418;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    color: rgba(255, 255, 255, 0.80);
    selection-background-color: rgba(255, 107, 0, 0.18);
    selection-color: #FF8C2A;
    padding: 4px;
}

/* ── INPUT CANTIDAD ─────────────────────────────────────────────────── */
QDoubleSpinBox#input_cantidad {
    background-color: #222226;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 10px;
    color: rgba(255, 255, 255, 0.88);
    padding: 10px 14px;
    font-size: 13px;
    min-height: 20px;
    selection-background-color: rgba(255, 107, 0, 0.30);
    selection-color: #FFFFFF;
}
QDoubleSpinBox#input_cantidad:hover {
    background-color: #27272C;
    border: 1px solid rgba(255, 255, 255, 0.18);
}
QDoubleSpinBox#input_cantidad:focus {
    background-color: #222226;
    border: 1px solid rgba(255, 107, 0, 0.60);
    color: #FFFFFF;
}
QDoubleSpinBox#input_cantidad::up-button,
QDoubleSpinBox#input_cantidad::down-button {
    background: rgba(255,255,255,0.05);
    border: none;
    border-radius: 4px;
    width: 18px;
}
QDoubleSpinBox#input_cantidad::up-button:hover,
QDoubleSpinBox#input_cantidad::down-button:hover {
    background: rgba(255,107,0,0.18);
}

/* ── BOTÓN COMPRAR (verde) ──────────────────────────────────────────── */
QPushButton#btn_comprar {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
        stop:0 #28A745, stop:1 #1E7A32);
    color: #FFFFFF;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 2px;
    border-radius: 10px;
    border-top: 1px solid rgba(100,255,130,0.20);
    border-bottom: 1px solid rgba(0,80,20,0.40);
    min-height: 42px;
    padding: 0 18px;
}
QPushButton#btn_comprar:hover {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
        stop:0 #34C759, stop:1 #28A745);
}
QPushButton#btn_comprar:pressed {
    background: #1A6B2A;
    padding-top: 1px;
}

/* ── BOTÓN VENDER (rojo) ────────────────────────────────────────────── */
QPushButton#btn_vender {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
        stop:0 #D63031, stop:1 #A11212);
    color: #FFFFFF;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 2px;
    border-radius: 10px;
    border-top: 1px solid rgba(255,120,120,0.18);
    border-bottom: 1px solid rgba(100,0,0,0.40);
    min-height: 42px;
    padding: 0 18px;
}
QPushButton#btn_vender:hover {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
        stop:0 #FF3B30, stop:1 #D63031);
}
QPushButton#btn_vender:pressed {
    background: #8B0000;
    padding-top: 1px;
}

/* ── BOTÓN VER DETALLES (secundario naranja) ────────────────────────── */
QPushButton#btn_ver_detalles {
    background: rgba(255, 107, 0, 0.10);
    color: #FF8C2A;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.5px;
    border: 1px solid rgba(255, 107, 0, 0.22);
    border-radius: 10px;
    min-height: 38px;
    padding: 0 18px;
}
QPushButton#btn_ver_detalles:hover {
    background: rgba(255, 107, 0, 0.18);
    border: 1px solid rgba(255, 107, 0, 0.40);
    color: #FFA040;
}
QPushButton#btn_ver_detalles:pressed {
    background: rgba(255, 107, 0, 0.08);
    padding-top: 1px;
}

/* ── TABLAS ─────────────────────────────────────────────────────────── */
QTableWidget#tabla_mercado,
QTableWidget#tabla_posiciones,
QTableWidget#tabla_noticias,
QTableWidget#tabla_historial {
    background: transparent;
    border: none;
    gridline-color: rgba(255, 255, 255, 0.04);
    color: rgba(255, 255, 255, 0.80);
    font-size: 12px;
    selection-background-color: rgba(255, 107, 0, 0.10);
    selection-color: rgba(255, 255, 255, 0.92);
    outline: none;
}
QTableWidget#tabla_mercado::item,
QTableWidget#tabla_posiciones::item,
QTableWidget#tabla_noticias::item,
QTableWidget#tabla_historial::item {
    padding: 10px 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
}
QTableWidget#tabla_mercado::item:selected,
QTableWidget#tabla_posiciones::item:selected,
QTableWidget#tabla_noticias::item:selected,
QTableWidget#tabla_historial::item:selected {
    background: rgba(255, 107, 0, 0.08);
    color: rgba(255, 255, 255, 0.92);
}
QTableWidget#tabla_mercado::item:hover,
QTableWidget#tabla_posiciones::item:hover,
QTableWidget#tabla_noticias::item:hover,
QTableWidget#tabla_historial::item:hover {
    background: rgba(255, 255, 255, 0.03);
}
QHeaderView::section {
    background-color: transparent;
    color: rgba(255, 255, 255, 0.28);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1.5px;
    padding: 10px 14px;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}

/* ── SCROLLBAR ──────────────────────────────────────────────────────── */
QScrollBar:vertical {
    background: transparent;
    width: 5px;
    border-radius: 3px;
    margin: 4px 0;
}
QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.14);
    border-radius: 3px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    background: rgba(255, 107, 0, 0.45);
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical { background: transparent; }

/* ── BADGE AVISO URGENTE ────────────────────────────────────────────── */
QLabel#lbl_badge_aviso {
    color: #FF6B00;
    background: rgba(255, 107, 0, 0.10);
    border: 1px solid rgba(255, 107, 0, 0.22);
    border-radius: 20px;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 1px;
    padding: 3px 10px;
}

/* ── PIE ────────────────────────────────────────────────────────────── */
QLabel#lbl_version {
    color: rgba(255, 255, 255, 0.10);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 1px;
    qproperty-alignment: AlignCenter;
}

   </string>
  </property>

  <widget class="QWidget" name="centralwidget">
   <layout class="QHBoxLayout" name="root_layout">
    <property name="spacing"><number>0</number></property>
    <property name="leftMargin"><number>0</number></property>
    <property name="topMargin"><number>0</number></property>
    <property name="rightMargin"><number>0</number></property>
    <property name="bottomMargin"><number>0</number></property>

    <!-- ══════════════════════════════════
         SIDEBAR — 220px fixed
         ══════════════════════════════════ -->
    <item>
     <widget class="QFrame" name="sidebar">
      <property name="minimumSize"><size><width>220</width><height>0</height></size></property>
      <property name="maximumSize"><size><width>220</width><height>16777215</height></size></property>
      <layout class="QVBoxLayout" name="vl_sidebar">
       <property name="spacing"><number>0</number></property>
       <property name="leftMargin"><number>0</number></property>
       <property name="topMargin"><number>0</number></property>
       <property name="rightMargin"><number>0</number></property>
       <property name="bottomMargin"><number>0</number></property>

       <!-- LOGO BLOQUE -->
       <item>
        <layout class="QVBoxLayout" name="vl_logo">
         <property name="leftMargin"><number>20</number></property>
         <property name="topMargin"><number>28</number></property>
         <property name="rightMargin"><number>20</number></property>
         <property name="bottomMargin"><number>24</number></property>
         <property name="spacing"><number>3</number></property>
         <item>
          <widget class="QLabel" name="lbl_sidebar_logo">
           <property name="text"><string>CRYPTOLEARNING</string></property>
          </widget>
         </item>
         <item>
          <widget class="QLabel" name="lbl_sidebar_sub">
           <property name="text"><string>Panel Trader</string></property>
          </widget>
         </item>
        </layout>
       </item>

       <!-- DIVISOR TOP -->
       <item>
        <widget class="QFrame" name="sep_sidebar">
         <property name="frameShape"><enum>QFrame::HLine</enum></property>
         <property name="minimumSize"><size><width>0</width><height>1</height></size></property>
         <property name="maximumSize"><size><width>16777215</width><height>1</height></size></property>
        </widget>
       </item>

       <!-- NAVEGACIÓN -->
       <item>
        <layout class="QVBoxLayout" name="vl_nav">
         <property name="spacing"><number>2</number></property>
         <property name="leftMargin"><number>12</number></property>
         <property name="topMargin"><number>20</number></property>
         <property name="rightMargin"><number>12</number></property>
         <property name="bottomMargin"><number>0</number></property>

         <item>
          <widget class="QLabel" name="lbl_nav_section">
           <property name="text"><string>TRADING</string></property>
           <property name="minimumSize"><size><width>0</width><height>24</height></size></property>
          </widget>
         </item>
         <item><spacer name="sp_nav_lbl"><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeType"><enum>QSizePolicy::Fixed</enum></property><property name="sizeHint" stdset="0"><size><width>0</width><height>4</height></size></property></spacer></item>

         <item>
          <widget class="QPushButton" name="btn_nav_mercado">
           <property name="cursor"><cursorShape>PointingHandCursor</cursorShape></property>
           <property name="text"><string>📊  Mercado</string></property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="btn_nav_cartera">
           <property name="cursor"><cursorShape>PointingHandCursor</cursorShape></property>
           <property name="text"><string>💼  Mi Cartera</string></property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="btn_nav_noticias">
           <property name="cursor"><cursorShape>PointingHandCursor</cursorShape></property>
           <property name="text"><string>📰  Noticias</string></property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="btn_nav_historial">
           <property name="cursor"><cursorShape>PointingHandCursor</cursorShape></property>
           <property name="text"><string>🕘  Historial</string></property>
          </widget>
         </item>
        </layout>
       </item>

       <!-- SPACER CRECER -->
       <item>
        <spacer name="sp_nav_grow">
         <property name="orientation"><enum>Qt::Vertical</enum></property>
         <property name="sizeType"><enum>QSizePolicy::Expanding</enum></property>
         <property name="sizeHint" stdset="0"><size><width>0</width><height>0</height></size></property>
        </spacer>
       </item>

       <!-- DIVISOR INFERIOR -->
       <item>
        <widget class="QFrame" name="sep_sidebar_bot">
         <property name="objectName"><string>sep_sidebar</string></property>
         <property name="frameShape"><enum>QFrame::HLine</enum></property>
         <property name="minimumSize"><size><width>0</width><height>1</height></size></property>
         <property name="maximumSize"><size><width>16777215</width><height>1</height></size></property>
        </widget>
       </item>

       <!-- USER PILL -->
       <item>
        <layout class="QVBoxLayout" name="vl_user">
         <property name="leftMargin"><number>12</number></property>
         <property name="topMargin"><number>14</number></property>
         <property name="rightMargin"><number>12</number></property>
         <property name="bottomMargin"><number>14</number></property>
         <item>
