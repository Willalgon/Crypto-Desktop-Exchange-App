               <attribute name="verticalHeaderVisible"><bool>false</bool></attribute>
               <attribute name="horizontalHeaderStretchLastSection"><bool>true</bool></attribute>
               <column><property name="text"><string>Activo</string></property></column>
               <column><property name="text"><string>Ticker</string></property></column>
               <column><property name="text"><string>Precio ($)</string></property></column>
              </widget>
             </item>
            </layout>
           </widget>
          </item>

          <!-- COLUMNA DERECHA: OPERAR + HISTORIAL -->
          <item>
           <layout class="QVBoxLayout" name="vl_derecha">
            <property name="spacing"><number>20</number></property>

            <!-- CARD OPERAR -->
            <item>
