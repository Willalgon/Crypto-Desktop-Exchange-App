                 <property name="rightMargin"><number>22</number></property>
                 <property name="bottomMargin"><number>20</number></property>

                 <!-- Activo seleccionado -->
                 <item><widget class="QLabel" name="lbl_activo_sel"><property name="text"><string>← Selecciona un activo del mercado</string></property></widget></item>
