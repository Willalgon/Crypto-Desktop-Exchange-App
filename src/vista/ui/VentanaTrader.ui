<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>TraderWindow</class>
 <widget class="QMainWindow" name="TraderWindow">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>1400</width><height>900</height></rect>
  </property>
  <property name="windowTitle">
   <string>CryptoLearning — Panel Trader</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
/* ═══════════════════════════════════════════
   CRYPTOLEARNING · TRADER PANEL
   Dark Matter · Robinhood Style
   ═══════════════════════════════════════════ */

QMainWindow, QWidget#centralwidget {
    background-color: #000000;
}

/* ── TOPBAR ──────────────────────────────── */
QWidget#topbar {
    background-color: #000000;
    border-bottom: 1px solid rgba(255,255,255,0.07);
}
QLabel#lbl_logo        { color: #FF6B00; font-size: 18px; font-weight: 800; letter-spacing: 1px; }
QLabel#lbl_logo_suffix { color: rgba(255,255,255,0.45); font-size: 18px; font-weight: 700; }
QLabel#lbl_bienvenida  { color: rgba(255,255,255,0.40); font-size: 13px; font-weight: 500; }
QLabel#lbl_avatar      { background-color: #FF6B00; color: #000; font-size: 12px; font-weight: 800; border-radius: 16px; padding: 4px 10px; }
QPushButton#btn_cerrar_sesion {
    background: transparent; color: rgba(255,255,255,0.30);
    font-size: 12px; font-weight: 600; border: none; padding: 4px 10px;
}
QPushButton#btn_cerrar_sesion:hover { color: #FF6B00; }

/* ── PAGE HEADER ─────────────────────────── */
QLabel#lbl_titulo    { color: #FFFFFF; font-size: 32px; font-weight: 800; letter-spacing: -1px; }
QLabel#lbl_subtitulo { color: rgba(255,255,255,0.35); font-size: 13px; font-weight: 500; }

/* ── SALDO FIAT BANNER ───────────────────── */
QFrame#frame_saldo {
    background-color: #0D0D0D;
    border-radius: 14px;
    border: 1px solid rgba(255,107,0,0.15);
}
QLabel#lbl_saldo_label     { color: rgba(255,255,255,0.30); font-size: 10px; font-weight: 700; letter-spacing: 1.2px; }
QLabel#lbl_saldo_valor     { color: #FFFFFF; font-size: 28px; font-weight: 800; letter-spacing: -0.5px; }
QLabel#lbl_patrimonio_label { color: rgba(255,255,255,0.25); font-size: 10px; font-weight: 700; letter-spacing: 1.2px; }
QLabel#lbl_patrimonio_valor { color: rgba(255,255,255,0.60); font-size: 20px; font-weight: 700; }

/* ── CARDS ───────────────────────────────── */
QFrame#frame_mercado,
QFrame#frame_operar,
QFrame#frame_historial {
    background-color: #0D0D0D;
    border-radius: 16px;
    border: 1px solid rgba(255,255,255,0.06);
}
QLabel#lbl_card_mercado,
QLabel#lbl_card_operar,
QLabel#lbl_card_historial {
    color: #FFFFFF; font-size: 15px; font-weight: 700; letter-spacing: -0.2px;
}

/* ── TABLAS ──────────────────────────────── */
QTableWidget {
    background-color: transparent;
    color: rgba(255,255,255,0.90);
    font-size: 13px; font-weight: 500;
    border: none;
    gridline-color: transparent;
    selection-background-color: rgba(255,107,0,0.10);
    selection-color: #FF8A33;
    outline: none;
}
QHeaderView { background-color: transparent; }
QHeaderView::section {
    background-color: transparent;
    color: rgba(255,255,255,0.30);
    font-size: 10px; font-weight: 700; letter-spacing: 1.4px;
    border: none;
    border-bottom: 1px solid rgba(255,255,255,0.07);
    padding: 10px 6px;
    text-transform: uppercase;
}
QTableWidget::item          { border: none; padding: 10px 6px; }
QTableWidget::item:selected { background-color: rgba(255,107,0,0.10); color: #FF8A33; }
QTableWidget::item:hover    { background-color: rgba(255,255,255,0.03); }

/* ── PANEL OPERAR ────────────────────────── */
QLabel#lbl_activo_sel   { color: rgba(255,255,255,0.50); font-size: 12px; font-weight: 500; }
QLabel#lbl_precio_actual { color: #FF6B00; font-size: 22px; font-weight: 800; }
QLabel#lbl_activo_desc  { color: rgba(255,255,255,0.30); font-size: 11px; font-weight: 500; font-style: italic; }

QLabel { color: rgba(255,255,255,0.60); font-size: 12px; font-weight: 600; letter-spacing: 0.3px; }

QDoubleSpinBox {
    background-color: #1A1A1E;
    color: #FFFFFF;
    font-size: 15px; font-weight: 700;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 10px;
    padding: 10px 14px;
}
QDoubleSpinBox:focus { border-color: rgba(255,107,0,0.40); }
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button { width: 0; border: none; }

QLabel#lbl_total_label { color: rgba(255,255,255,0.35); font-size: 11px; font-weight: 600; letter-spacing: 0.5px; }
QLabel#lbl_total_valor { color: #FFFFFF; font-size: 18px; font-weight: 800; }

QPushButton#btn_comprar {
    background-color: #00C851;
    color: #000000;
    font-size: 14px; font-weight: 800;
    border: none; border-radius: 10px;
    padding: 13px; letter-spacing: 0.3px;
}
QPushButton#btn_comprar:hover   { background-color: #00E65C; }
QPushButton#btn_comprar:pressed { background-color: #00A844; }

QPushButton#btn_vender {
    background-color: #FF3B30;
    color: #FFFFFF;
    font-size: 14px; font-weight: 800;
    border: none; border-radius: 10px;
    padding: 13px; letter-spacing: 0.3px;
}
QPushButton#btn_vender:hover   { background-color: #FF5C52; }
QPushButton#btn_vender:pressed { background-color: #D93228; }

/* ── SCROLLBAR ───────────────────────────── */
QScrollBar:vertical { background: transparent; width: 4px; }
QScrollBar::handle:vertical { background: rgba(255,255,255,0.10); border-radius: 2px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }
   </string>
  </property>

  <widget class="QWidget" name="centralwidget">
   <layout class="QVBoxLayout" name="vl_root">
    <property name="spacing"><number>0</number></property>
