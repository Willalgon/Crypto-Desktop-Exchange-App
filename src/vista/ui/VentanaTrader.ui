    <!-- ══ TOPBAR ══ -->
    <item>
     <widget class="QWidget" name="topbar">
      <property name="minimumHeight"><number>56</number></property>
      <property name="maximumHeight"><number>56</number></property>
      <layout class="QHBoxLayout" name="hl_topbar">
       <property name="leftMargin"><number>40</number></property>
