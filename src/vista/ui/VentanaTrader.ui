       <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property></spacer></item>
       <item><widget class="QPushButton" name="btn_cerrar_sesion"><property name="text"><string>Cerrar sesión</string></property><property name="cursor"><cursorShape>PointingHandCursor</cursorShape></property></widget></item>
       <item><widget class="QLabel" name="lbl_avatar"><property name="text"><string>TR</string></property></widget></item>
      </layout>
     </widget>
    </item>

    <!-- ══ SCROLL AREA ══ -->
    <item>
     <widget class="QScrollArea" name="scrollArea">
      <property name="widgetResizable"><bool>true</bool></property>
      <property name="frameShape"><enum>QFrame::NoFrame</enum></property>
      <property name="styleSheet"><string notr="true">QScrollArea { background: #000000; border: none; }</string></property>
      <widget class="QWidget" name="scrollContents">
       <layout class="QVBoxLayout" name="vl_scroll">
        <property name="spacing"><number>20</number></property>
        <property name="leftMargin"><number>40</number></property>
        <property name="topMargin"><number>36</number></property>
        <property name="rightMargin"><number>40</number></property>
        <property name="bottomMargin"><number>50</number></property>

        <!-- PAGE HEADER -->
        <item>
         <layout class="QVBoxLayout" name="vl_header">
          <property name="spacing"><number>4</number></property>
          <item><widget class="QLabel" name="lbl_titulo"><property name="text"><string>Mi Mercado</string></property></widget></item>
          <item><widget class="QLabel" name="lbl_subtitulo"><property name="text"><string>Compra y vende activos con tu saldo virtual</string></property></widget></item>
         </layout>
        </item>

        <!-- SALDO BANNER -->
        <item>
         <widget class="QFrame" name="frame_saldo">
          <layout class="QHBoxLayout" name="hl_saldo">
           <property name="leftMargin"><number>28</number></property>
           <property name="topMargin"><number>20</number></property>
           <property name="rightMargin"><number>28</number></property>
           <property name="bottomMargin"><number>20</number></property>
