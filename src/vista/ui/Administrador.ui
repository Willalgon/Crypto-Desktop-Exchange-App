  <property name="styleSheet">
   <string notr="true">
/* ═══════════════════════════════════════════════════════
   CRYPTOLEARNING · ADMIN PANEL
   Dark Matter Edition · Robinhood Style
   ═══════════════════════════════════════════════════════ */

/* BASE */
QMainWindow, QWidget#centralwidget {
    background-color: #080809;
}

/* ── TOPBAR ─────────────────────────────────────────── */
QWidget#topbar {
    background-color: #080809;
    border-bottom: 1px solid rgba(255,255,255,0.05);
}

QLabel#lbl_logo {
    color: #FF6B00;
    font-size: 18px;
    font-weight: 800;
    letter-spacing: 1px;
}

QLabel#lbl_logo_suffix {
    color: rgba(255,255,255,0.45);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 1px;
}

QLabel#lbl_live {
    color: rgba(255,255,255,0.35);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
}

QLabel#lbl_avatar {
    background-color: #FF6B00;
    color: #000000;
    font-size: 12px;
    font-weight: 800;
    border-radius: 16px;
    padding: 4px 10px;
}

/* ── PAGE HEADER ────────────────────────────────────── */
QLabel#lbl_titulo_seccion {
    color: #FFFFFF;
    font-size: 36px;
    font-weight: 800;
    letter-spacing: -1px;
}

QLabel#lbl_subtitulo {
    color: rgba(255,255,255,0.35);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.3px;
}

/* ── STAT CARDS (métricas superiores) ───────────────── */
QFrame#stat_alumnos,
QFrame#stat_activos,
QFrame#stat_liquidez,
QFrame#stat_eventos {
    background-color: #111113;
    border-radius: 14px;
    border: 1px solid rgba(255,255,255,0.04);
}

QLabel#lbl_stat_label_1,
QLabel#lbl_stat_label_2,
QLabel#lbl_stat_label_3,
QLabel#lbl_stat_label_4 {
    color: rgba(255,255,255,0.30);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.2px;
}

QLabel#lbl_stat_value_1,
QLabel#lbl_stat_value_2,
QLabel#lbl_stat_value_3,
QLabel#lbl_stat_value_4 {
    color: #FFFFFF;
    font-size: 26px;
    font-weight: 800;
    letter-spacing: -0.5px;
}

QLabel#lbl_stat_delta_1,
QLabel#lbl_stat_delta_2,
QLabel#lbl_stat_delta_3 {
    color: rgba(255,255,255,0.35);
    font-size: 11px;
    font-weight: 600;
}

QLabel#lbl_stat_delta_4 {
    color: rgba(255,107,0,0.75);
    font-size: 11px;
    font-weight: 600;
}

/* ── MAIN CARDS ─────────────────────────────────────── */
QFrame#frame_usuarios,
QFrame#frame_activos,
QFrame#frame_eventos {
    background-color: #111113;
    border-radius: 16px;
    border: 1px solid rgba(255,255,255,0.04);
}

/* Cabeceras de tarjeta */
QLabel#lbl_card1,
QLabel#lbl_card2,
QLabel#lbl_card3 {
    color: #FFFFFF;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.2px;
}

QLabel#lbl_count_usuarios,
QLabel#lbl_count_activos,
QLabel#lbl_count_eventos {
    color: rgba(255,255,255,0.30);
    font-size: 11px;
    font-weight: 700;
    background-color: rgba(255,255,255,0.06);
    border-radius: 10px;
    padding: 3px 10px;
    letter-spacing: 0.4px;
}

/* Separador de cabecera */
QFrame#line_usuarios,
QFrame#line_activos,
QFrame#line_eventos {
    color: rgba(255,255,255,0.04);
}

/* ── TABLAS ─────────────────────────────────────────── */
QTableWidget {
    background-color: transparent;
    color: rgba(255,255,255,0.85);
    font-size: 13px;
    font-weight: 500;
    border: none;
    gridline-color: rgba(255,255,255,0.03);
    selection-background-color: rgba(255,107,0,0.10);
    selection-color: #FF8A33;
    outline: none;
}

QHeaderView::section {
    background-color: transparent;
    color: rgba(255,255,255,0.25);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.2px;
    border: none;
    border-bottom: 1px solid rgba(255,255,255,0.04);
    padding: 10px 6px;
    text-transform: uppercase;
}

QTableWidget::item {
    border-bottom: 1px solid rgba(255,255,255,0.03);
    padding: 8px 6px;
}

QTableWidget::item:selected {
    background-color: rgba(255,107,0,0.10);
    color: #FF8A33;
}

QTableWidget::item:hover {
    background-color: rgba(255,255,255,0.03);
}

QScrollBar:vertical {
    background: transparent;
    width: 4px;
}
QScrollBar::handle:vertical {
    background: rgba(255,255,255,0.10);
    border-radius: 2px;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical { height: 0px; }

/* ── BOTONES SECUNDARIOS ────────────────────────────── */
QPushButton {
    background-color: rgba(255,255,255,0.05);
    color: rgba(255,255,255,0.70);
    font-size: 13px;
    font-weight: 600;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 10px;
    padding: 11px 16px;
    letter-spacing: 0.2px;
}

QPushButton:hover {
    background-color: rgba(255,64,64,0.12);
    color: #FF6666;
    border-color: rgba(255,64,64,0.25);
}

QPushButton:pressed {
    background-color: rgba(255,64,64,0.18);
}

/* ── BOTÓN PRIMARIO ─────────────────────────────────── */
QPushButton#btn_lanzar_evento {
    background-color: #FF6B00;
    color: #000000;
    font-size: 14px;
    font-weight: 800;
    border: none;
    border-radius: 10px;
    padding: 14px 16px;
    letter-spacing: 0.4px;
}

QPushButton#btn_lanzar_evento:hover {
    background-color: #FF8533;
}

QPushButton#btn_lanzar_evento:pressed {
    background-color: #E55A00;
}

/* ── COMBO Y TEXTAREA ───────────────────────────────── */
QComboBox {
    background-color: #1A1A1E;
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 600;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 10px;
    padding: 12px 14px;
    letter-spacing: 0.2px;
}

QComboBox:focus {
    border-color: rgba(255,107,0,0.40);
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid rgba(255,255,255,0.4);
    margin-right: 8px;
}

QComboBox QAbstractItemView {
    background-color: #1A1A1E;
    color: rgba(255,255,255,0.85);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 10px;
    selection-background-color: rgba(255,107,0,0.20);
    selection-color: #FF8A33;
    padding: 4px;
    outline: none;
}

QTextEdit {
    background-color: #1A1A1E;
    color: rgba(255,255,255,0.80);
    font-size: 13px;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 10px;
    padding: 12px 14px;
}

QTextEdit:focus {
    border-color: rgba(255,107,0,0.35);
}
   </string>
