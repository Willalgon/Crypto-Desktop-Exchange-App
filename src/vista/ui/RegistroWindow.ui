  <property name="styleSheet">
   <string notr="true">
/* FONDO NEGRO PURO IDENTICO AL LOGIN */
QMainWindow { background-color: #000000; }
QFrame { background: transparent; border: none; }

/* TITULO */
QLabel#lbl_titulo { 
    color: #FFFFFF; 
    font-size: 32px; 
    font-weight: bold; 
    font-family: 'Inter', 'Roboto', 'sans-serif';
}

QLabel#lbl_subtitulo { 
    color: #8B94A5; 
    font-size: 16px;
}

/* INPUTS CON BORDE NARANJA */
QLineEdit {
    background-color: #0D1117;
    border: 2px solid #FF6A00;
    border-radius: 8px;
    color: #FFFFFF;
    padding: 12px 20px; 
    font-size: 14px;
}
QLineEdit:focus {
    border: 2px solid #FF4500;
    background-color: #161B22;
}

/* BOTÓN NARANJA */
QPushButton#btn_registrar {
    background-color: #FF6A00;
    color: #000000;
    font-weight: bold;
    font-size: 18px;
    border-radius: 8px;
    padding: 16px;
}
QPushButton#btn_registrar:hover { 
    background-color: #FF4500;
}

/* ENLACE VOLVER */
QPushButton#btn_volver { 
    color: #8B94A5; 
    background: transparent; 
    border: none; 
    font-size: 14px;
}
QPushButton#btn_volver:hover { color: #FF6A00; text-decoration: underline; }
