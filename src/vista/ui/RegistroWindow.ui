  <property name="styleSheet">
   <string notr="true">
    /* FONDO CONTINUO */
    QMainWindow { background-color: #080B10; }
    QFrame { background: transparent; border: none; }
    
    /* TEXTOS DEL LOGIN - Escalados */
QLabel#lbl_titulo { 
    color: #FFFFFF; 
    font-size: 32px; 
    font-weight: bold; 
    font-family: 'Inter', 'Roboto', 'Helvetica Neue', 'Arial', sans-serif;
    letter-spacing: 1px;
}
QLabel#lbl_subtitulo { 
    color: #8B94A5; 
    font-size: 16px; 
    font-family: 'Inter', 'Roboto', 'Helvetica Neue', 'Arial', sans-serif;
}

/* CAMPOS DE TEXTO - Altura y legibilidad */
QLineEdit {
    background-color: #121824;
    border: 1px solid #1F2A3D;
    border-radius: 8px;
    color: #FFFFFF;
    padding: 16px 20px;
    font-size: 16px;
    font-family: 'Roboto', sans-serif;
}
QLineEdit:focus {
    border: 1px solid #C48B54;
    background-color: #161D2B;
}

/* BOTÓN PRINCIPAL - Botón robusto */
QPushButton#btn_registrar {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #A66C3D, stop:1 #C48B54);
    color: #080B10;
    font-weight: bold;
    font-size: 18px;
    font-family: 'Inter', 'Roboto', sans-serif;
    border-radius: 8px;
    padding: 18px;
    letter-spacing: 2px;
}
QPushButton#btn_registrar:hover { background-color: #DDA76A; }

/* ENLACE INFERIOR */
QPushButton#btn_volver { 
    color: #8B94A5; 
    background: transparent; 
    border: none; 
    font-size: 14px; 
    font-family: 'Inter', 'Roboto', sans-serif;
}
QPushButton#btn_volver:hover { color: #C48B54; text-decoration: underline; }
