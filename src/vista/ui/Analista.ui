<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>AnalistaWindow</class>
 <widget class="QMainWindow" name="AnalistaWindow">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>1400</width><height>860</height></rect>
  </property>
  <property name="windowTitle">
   <string>CryptoLearning — Panel Analista</string>
  </property>

  <property name="styleSheet">
   <string notr="true">

/* ═══════════════════════════════════════════════════════════════════════
   CRYPTOLEARNING  ·  PANEL ANALISTA
   Pure Black Spatial  ·  Deep Dark Edition
   ═══════════════════════════════════════════════════════════════════════ */

/* ── VENTANA BASE ───────────────────────────────────────────────────── */
QMainWindow, QWidget#centralwidget {
    background-color: #000000;
}
QFrame { background: transparent; border: none; }

/* ── SIDEBAR ────────────────────────────────────────────────────────── */
QFrame#sidebar {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0.00 rgba(10, 8, 14, 255),
        stop:1.00 rgba(6, 5, 9, 255)
    );
    border-right: 1px solid rgba(255, 106, 0, 40);
}

/* ── LOGO SIDEBAR ───────────────────────────────────────────────────── */
QLabel#lbl_sidebar_logo {
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 800;
    font-family: "Helvetica Neue", "Segoe UI Semibold", Arial, sans-serif;
    letter-spacing: 4px;
    qproperty-alignment: AlignCenter;
}
QLabel#lbl_sidebar_sub {
    color: rgba(255, 120, 0, 160);
    font-size: 8px;
    font-family: "Helvetica Neue", "Segoe UI", Arial, sans-serif;
    letter-spacing: 3px;
    qproperty-alignment: AlignCenter;
}

/* ── SEPARADOR SIDEBAR ──────────────────────────────────────────────── */
QFrame#sep_sidebar {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0.00 rgba(255, 106, 0,   0),
        stop:0.40 rgba(255, 106, 0, 100),
        stop:0.60 rgba(255, 160, 0, 180),
        stop:1.00 rgba(255, 106, 0,   0)
    );
    min-height: 1px;
    max-height: 1px;
    border: none;
}

/* ── BOTONES SIDEBAR NAV ────────────────────────────────────────────── */
QPushButton#btn_nav_noticias,
QPushButton#btn_nav_historial,
QPushButton#btn_nav_salir {
    background: transparent;
    color: rgba(255, 255, 255, 110);
    font-size: 10px;
    font-weight: 600;
    font-family: "Helvetica Neue", "Segoe UI", Arial, sans-serif;
    letter-spacing: 2px;
    border: none;
    border-radius: 10px;
    padding: 14px 16px;
    text-align: left;
}
QPushButton#btn_nav_noticias:hover,
QPushButton#btn_nav_historial:hover {
    background: rgba(255, 106, 0, 18);
    color: #FF8C00;
    border-left: 2px solid rgba(255, 130, 0, 200);
}
QPushButton#btn_nav_noticias:pressed,
QPushButton#btn_nav_historial:pressed {
    background: rgba(255, 106, 0, 30);
    color: #FFA040;
}
QPushButton#btn_nav_salir {
    color: rgba(255, 80, 80, 120);
}
QPushButton#btn_nav_salir:hover {
    background: rgba(200, 40, 40, 18);
    color: rgba(255, 100, 100, 220);
    border-left: 2px solid rgba(220, 60, 60, 180);
}

/* ── ÁREA PRINCIPAL ─────────────────────────────────────────────────── */
QFrame#main_area {
    background: qradialgradient(
        cx: 0.30, cy: 0.20, radius: 1.10,
        stop: 0.00 rgba(18, 14, 24, 255),
        stop: 0.50 rgba(9,  7, 13, 255),
        stop: 1.00 rgba(4,  3,  7, 255)
    );
}

/* ── HEADER PRINCIPAL ───────────────────────────────────────────────── */
QFrame#header_bar {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(20, 16, 28, 255),
        stop:1 rgba(10,  8, 14, 255)
    );
    border-bottom: 1px solid rgba(255, 106, 0, 35);
}
QLabel#lbl_header_titulo {
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 700;
    font-family: "Helvetica Neue", "Segoe UI Semibold", Arial, sans-serif;
    letter-spacing: 3px;
}
QLabel#lbl_header_rol {
    color: rgba(255, 130, 0, 180);
    font-size: 9px;
    font-family: "Helvetica Neue", "Segoe UI", Arial, sans-serif;
    letter-spacing: 2.5px;
}
QLabel#lbl_header_usuario {
    color: rgba(255, 255, 255, 140);
    font-size: 10px;
    font-family: "Helvetica Neue", "Segoe UI", Arial, sans-serif;
    letter-spacing: 1px;
    qproperty-alignment: AlignRight;
}

/* ── GLOW LINE HEADER ───────────────────────────────────────────────── */
QFrame#header_glow {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0.00 rgba(255, 106,  0,   0),
        stop:0.20 rgba(255, 106,  0,  80),
        stop:0.50 rgba(255, 160,  0, 200),
        stop:0.80 rgba(255, 106,  0,  80),
        stop:1.00 rgba(255, 106,  0,   0)
    );
    min-height: 1px;
    max-height: 1px;
    border: none;
}

/* ── CARD PUBLICAR NOTICIA ──────────────────────────────────────────── */
QFrame#card_publicar {
    background: qradialgradient(
        cx: 0.50, cy: 0.30, radius: 0.90,
        stop: 0.00 rgba(26, 20, 36, 255),
        stop: 0.60 rgba(14, 11, 20, 255),
        stop: 1.00 rgba( 7,  5, 11, 255)
    );
    border-top:    1px solid rgba(255, 255, 255, 50);
    border-left:   1px solid rgba(255, 255, 255, 28);
    border-right:  1px solid rgba(255, 255, 255, 16);
    border-bottom: 1px solid rgba(255, 255, 255, 10);
    border-radius: 20px;
}
QFrame#card_glow_publicar {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0.00 rgba(255, 106,  0,   0),
        stop:0.25 rgba(255, 106,  0, 110),
        stop:0.50 rgba(255, 160,  0, 240),
        stop:0.75 rgba(255, 106,  0, 110),
        stop:1.00 rgba(255, 106,  0,   0)
    );
    min-height: 1px;
    max-height: 1px;
    border: none;
}

/* ── CARD HISTORIAL ─────────────────────────────────────────────────── */
QFrame#card_historial {
    background: qradialgradient(
        cx: 0.50, cy: 0.20, radius: 0.90,
        stop: 0.00 rgba(22, 17, 30, 255),
        stop: 0.60 rgba(12, 10, 17, 255),
        stop: 1.00 rgba( 6,  5,  9, 255)
    );
    border-top:    1px solid rgba(255, 255, 255, 45);
    border-left:   1px solid rgba(255, 255, 255, 25);
    border-right:  1px solid rgba(255, 255, 255, 14);
    border-bottom: 1px solid rgba(255, 255, 255, 8);
    border-radius: 20px;
}
QFrame#card_glow_historial {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0.00 rgba(255, 106,  0,   0),
        stop:0.25 rgba(255, 106,  0,  80),
        stop:0.50 rgba(255, 160,  0, 180),
        stop:0.75 rgba(255, 106,  0,  80),
        stop:1.00 rgba(255, 106,  0,   0)
    );
    min-height: 1px;
    max-height: 1px;
    border: none;
}

/* ── TÍTULOS DE CARD ────────────────────────────────────────────────── */
QLabel#lbl_card_titulo,
QLabel#lbl_hist_titulo {
    color: #FFFFFF;
    font-size: 11px;
    font-weight: 700;
    font-family: "Helvetica Neue", "Segoe UI Semibold", Arial, sans-serif;
    letter-spacing: 2.5px;
}
QLabel#lbl_card_desc,
QLabel#lbl_hist_desc {
    color: rgba(255, 255, 255, 55);
    font-size: 9px;
    font-family: "Helvetica Neue", "Segoe UI", Arial, sans-serif;
    letter-spacing: 1px;
}

/* ── ETIQUETAS DE CAMPO ─────────────────────────────────────────────── */
QLabel#lbl_f_titulo,
QLabel#lbl_f_cuerpo,
QLabel#lbl_f_tipo {
    color: rgba(255, 140, 0, 170);
    font-size: 9px;
    font-weight: 700;
    font-family: "Helvetica Neue", "Segoe UI", Arial, sans-serif;
    letter-spacing: 2.2px;
    padding-left: 1px;
}

/* ── INPUT TÍTULO ───────────────────────────────────────────────────── */
QLineEdit#input_titulo {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(255, 255, 255,  7),
        stop:1 rgba(255, 255, 255,  3)
    );
    border: 1px solid rgba(255, 255, 255, 16);
    border-bottom: 1px solid rgba(255, 255, 255, 26);
    border-radius: 10px;
    color: rgba(255, 255, 255, 215);
    padding: 10px 14px;
    font-size: 13px;
    font-family: "Helvetica Neue", "Segoe UI", Arial, sans-serif;
    min-height: 20px;
    selection-background-color: rgba(255, 106, 0, 100);
    selection-color: #FFFFFF;
}
QLineEdit#input_titulo:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(255, 255, 255, 11),
        stop:1 rgba(255, 255, 255,  6)
    );
    border: 1px solid rgba(255, 255, 255, 40);
    border-bottom: 1px solid rgba(255, 255, 255, 55);
    color: #FFFFFF;
}
QLineEdit#input_titulo:focus {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(255, 106, 0, 20),
        stop:1 rgba(255,  80, 0,  8)
    );
    border: 1px solid rgba(255, 130, 0, 180);
    border-bottom: 1px solid rgba(255, 160, 0, 240);
    color: #FFFFFF;
}

/* ── TEXTAREA CUERPO ────────────────────────────────────────────────── */
QTextEdit#input_cuerpo {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(255, 255, 255,  6),
        stop:1 rgba(255, 255, 255,  2)
    );
    border: 1px solid rgba(255, 255, 255, 14);
    border-bottom: 1px solid rgba(255, 255, 255, 22);
    border-radius: 12px;
    color: rgba(255, 255, 255, 200);
    padding: 12px 14px;
    font-size: 12px;
    font-family: "Helvetica Neue", "Segoe UI", Arial, sans-serif;
    selection-background-color: rgba(255, 106, 0, 100);
    selection-color: #FFFFFF;
}
QTextEdit#input_cuerpo:focus {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(255, 106, 0, 16),
        stop:1 rgba(255,  80, 0,  6)
    );
    border: 1px solid rgba(255, 130, 0, 160);
    border-bottom: 1px solid rgba(255, 160, 0, 220);
    color: #FFFFFF;
}

/* ── CHECKBOX AVISO ─────────────────────────────────────────────────── */
QCheckBox#chk_aviso {
    color: rgba(255, 255, 255, 140);
    font-size: 10px;
    font-family: "Helvetica Neue", "Segoe UI", Arial, sans-serif;
    letter-spacing: 1px;
    spacing: 8px;
}
QCheckBox#chk_aviso::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 30);
    background: rgba(255, 255, 255, 6);
}
QCheckBox#chk_aviso::indicator:hover {
    border: 1px solid rgba(255, 130, 0, 180);
    background: rgba(255, 106, 0, 14);
}
QCheckBox#chk_aviso::indicator:checked {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,
        stop:0 #FF5E00, stop:1 #FF8000);
    border: 1px solid rgba(255, 200, 100, 160);
}

/* ── BOTÓN PUBLICAR ─────────────────────────────────────────────────── */
QPushButton#btn_publicar {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0.0  #FF5E00,
        stop:0.5  #FF8000,
        stop:1.0  #FF5200
    );
    color: #000000;
    font-weight: 800;
    font-size: 11px;
    font-family: "Helvetica Neue", "Segoe UI Semibold", Arial, sans-serif;
    letter-spacing: 3.5px;
    border-radius: 11px;
    border-top:    1px solid rgba(255, 200, 100, 160);
    border-left:   1px solid rgba(255, 200, 100,  80);
    border-right:  1px solid rgba(180,  80,   0,  80);
    border-bottom: 1px solid rgba(160,  60,   0, 120);
    min-height: 46px;
    padding: 0 20px;
}
QPushButton#btn_publicar:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0.0  #FF7520,
        stop:0.5  #FFA040,
        stop:1.0  #FF6A18
    );
    color: #000000;
}
QPushButton#btn_publicar:pressed {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0.0  #D94E00,
        stop:0.5  #E06A00,
        stop:1.0  #D04400
    );
    padding-top: 1px;
}

/* ── BOTÓN LIMPIAR ──────────────────────────────────────────────────── */
QPushButton#btn_limpiar {
    background: transparent;
    color: rgba(255, 255, 255, 55);
    font-size: 10px;
    font-family: "Helvetica Neue", "Segoe UI", Arial, sans-serif;
    letter-spacing: 1.5px;
    border: 1px solid rgba(255, 255, 255, 18);
    border-radius: 11px;
    min-height: 46px;
    padding: 0 20px;
}
QPushButton#btn_limpiar:hover {
    color: rgba(255, 255, 255, 180);
    border: 1px solid rgba(255, 255, 255, 50);
}
QPushButton#btn_limpiar:pressed {
    background: rgba(255, 255, 255, 8);
}

/* ── TABLA HISTORIAL ────────────────────────────────────────────────── */
QTableWidget#tabla_noticias {
    background: transparent;
    border: none;
    gridline-color: rgba(255, 255, 255, 10);
    color: rgba(255, 255, 255, 200);
    font-size: 11px;
    font-family: "Helvetica Neue", "Segoe UI", Arial, sans-serif;
    selection-background-color: rgba(255, 106, 0, 40);
    selection-color: #FFFFFF;
    outline: none;
}
QTableWidget#tabla_noticias::item {
    padding: 10px 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 8);
}
QTableWidget#tabla_noticias::item:selected {
    background: rgba(255, 106, 0, 35);
    color: #FFFFFF;
}
QHeaderView::section {
    background: rgba(255, 255, 255, 6);
    color: rgba(255, 140, 0, 180);
    font-size: 9px;
    font-weight: 700;
    font-family: "Helvetica Neue", "Segoe UI", Arial, sans-serif;
    letter-spacing: 2px;
    padding: 10px 12px;
    border: none;
    border-bottom: 1px solid rgba(255, 106, 0, 50);
}
QScrollBar:vertical {
    background: rgba(255, 255, 255, 4);
    width: 6px;
    border-radius: 3px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: rgba(255, 106, 0, 120);
    border-radius: 3px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: rgba(255, 130, 0, 200);
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical { height: 0; }

/* ── BADGE AVISO ────────────────────────────────────────────────────── */
QLabel#lbl_badge_aviso {
    color: #FF6A00;
    background: rgba(255, 106, 0, 18);
    border: 1px solid rgba(255, 106, 0, 80);
    border-radius: 6px;
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 1.5px;
    padding: 2px 7px;
    font-family: "Helvetica Neue", "Segoe UI", Arial, sans-serif;
}

/* ── PIE ────────────────────────────────────────────────────────────── */
QLabel#lbl_version {
    color: rgba(255, 255, 255, 15);
    font-size: 9px;
    font-family: "Helvetica Neue", "Segoe UI", Arial, sans-serif;
    letter-spacing: 1.8px;
    qproperty-alignment: AlignCenter;
}

