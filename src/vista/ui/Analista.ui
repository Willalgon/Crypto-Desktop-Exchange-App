<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>AnalistaWindow</class>
 <widget class="QMainWindow" name="AnalistaWindow">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>1400</width><height>860</height></rect>
  </property>
  <property name="windowTitle">
   <string>CryptoLearning — Panel Analista</string>
  </property>

  <property name="styleSheet">
   <string notr="true">

/* ═══════════════════════════════════════════════════════════════════════
   CRYPTOLEARNING  ·  PANEL ANALISTA
   Apple Spatial Design  ·  Dark Matter Edition
   ═══════════════════════════════════════════════════════════════════════
   Palette:
     Surface-0  #0A0A0B   — void black
     Surface-1  #111113   — deep base
     Surface-2  #18181B   — card ground
     Surface-3  #222226   — raised card
     Surface-4  #2C2C31   — input field
     Divider    rgba(255,255,255,0.06)
     Border     rgba(255,255,255,0.10)
     Border-hi  rgba(255,255,255,0.16)
     Accent     #FF6B00   — CryptoOrange
     Accent-hi  #FF8C2A   — warm highlight
     Accent-glo rgba(255,107,0,0.14)
     Text-pri   rgba(255,255,255,0.92)
     Text-sec   rgba(255,255,255,0.50)
     Text-ter   rgba(255,255,255,0.25)
   ═══════════════════════════════════════════════════════════════════════ */

/* ── BASE ───────────────────────────────────────────────────────────── */
QMainWindow, QWidget#centralwidget {
    background-color: #0A0A0B;
    font-family: "SF Pro Display", "Helvetica Neue", "Segoe UI Variable", Arial, sans-serif;
}
QFrame { background: transparent; border: none; }

/* ── SIDEBAR ────────────────────────────────────────────────────────── */
QFrame#sidebar {
    background-color: #111113;
    border-right: 1px solid rgba(255, 255, 255, 0.06);
}

/* ── LOGO ───────────────────────────────────────────────────────────── */
QLabel#lbl_sidebar_logo {
    color: rgba(255, 255, 255, 0.92);
    font-size: 13px;
    font-weight: 700;
    font-family: "SF Pro Display", "Helvetica Neue", Arial, sans-serif;
    letter-spacing: 2px;
    qproperty-alignment: AlignLeft;
}
QLabel#lbl_sidebar_sub {
    color: #FF6B00;
    font-size: 10px;
    font-weight: 500;
    font-family: "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
    letter-spacing: 1.5px;
    qproperty-alignment: AlignLeft;
}

/* ── SEPARADOR ──────────────────────────────────────────────────────── */
QFrame#sep_sidebar {
    background-color: rgba(255, 255, 255, 0.06);
    min-height: 1px;
    max-height: 1px;
    border: none;
}

/* ── SECCIÓN NAV LABEL ──────────────────────────────────────────────── */
QLabel#lbl_nav_section {
    color: rgba(255, 255, 255, 0.22);
    font-size: 9px;
    font-weight: 600;
    font-family: "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
    letter-spacing: 2px;
    padding-left: 16px;
}

/* ── BOTONES NAV ────────────────────────────────────────────────────── */
QPushButton#btn_nav_noticias,
QPushButton#btn_nav_historial,
QPushButton#btn_nav_salir {
    background: transparent;
    color: rgba(255, 255, 255, 0.45);
    font-size: 12px;
    font-weight: 500;
    font-family: "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
    letter-spacing: 0.2px;
    border: none;
    border-radius: 10px;
    padding: 10px 14px 10px 14px;
    text-align: left;
}
QPushButton#btn_nav_noticias:hover,
QPushButton#btn_nav_historial:hover {
    background: rgba(255, 255, 255, 0.05);
    color: rgba(255, 255, 255, 0.80);
}
QPushButton#btn_nav_noticias:pressed,
QPushButton#btn_nav_historial:pressed {
    background: rgba(255, 107, 0, 0.10);
    color: #FF8C2A;
}
QPushButton#btn_nav_salir {
    color: rgba(255, 80, 80, 0.45);
}
QPushButton#btn_nav_salir:hover {
    background: rgba(255, 60, 60, 0.07);
    color: rgba(255, 100, 100, 0.80);
}

/* ── INDICADOR ACTIVO ───────────────────────────────────────────────── */
QPushButton#btn_nav_noticias[active="true"] {
    background: rgba(255, 107, 0, 0.12);
    color: #FF8C2A;
}

/* ── AVATAR USUARIO ─────────────────────────────────────────────────── */
QFrame#user_pill {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
}
QLabel#lbl_user_name {
    color: rgba(255, 255, 255, 0.70);
    font-size: 11px;
    font-weight: 500;
    font-family: "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
}
QLabel#lbl_user_role {
    color: rgba(255, 107, 0, 0.70);
    font-size: 9px;
    font-weight: 400;
    font-family: "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
    letter-spacing: 0.5px;
}
QLabel#lbl_user_avatar {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,
        stop:0 #FF6B00, stop:1 #FF3D00);
    color: #000000;
    font-size: 11px;
    font-weight: 700;
    font-family: "SF Pro Display", "Helvetica Neue", Arial, sans-serif;
    border-radius: 10px;
    qproperty-alignment: AlignCenter;
}

/* ── ÁREA PRINCIPAL ─────────────────────────────────────────────────── */
QFrame#main_area {
    background-color: #0A0A0B;
}

/* ── TOPBAR ─────────────────────────────────────────────────────────── */
QFrame#topbar {
    background-color: rgba(10, 10, 11, 0.85);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}
QLabel#lbl_topbar_title {
    color: rgba(255, 255, 255, 0.92);
    font-size: 15px;
    font-weight: 600;
    font-family: "SF Pro Display", "Helvetica Neue", Arial, sans-serif;
    letter-spacing: -0.2px;
}
QLabel#lbl_topbar_breadcrumb {
    color: rgba(255, 255, 255, 0.28);
    font-size: 11px;
    font-weight: 400;
    font-family: "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
}
QLabel#lbl_topbar_breadcrumb_sep {
    color: rgba(255, 255, 255, 0.15);
    font-size: 11px;
    font-family: "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
}
QLabel#lbl_topbar_breadcrumb_active {
    color: rgba(255, 255, 255, 0.55);
    font-size: 11px;
    font-weight: 500;
    font-family: "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
}

/* ── BADGE LIVE ─────────────────────────────────────────────────────── */
QLabel#lbl_live_dot {
    background: #34C759;
    border-radius: 4px;
    min-width: 8px;
    max-width: 8px;
    min-height: 8px;
    max-height: 8px;
}
QLabel#lbl_live_text {
    color: rgba(52, 199, 89, 0.80);
    font-size: 10px;
    font-weight: 600;
    font-family: "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
    letter-spacing: 0.5px;
}

/* ── CARD GLASSMORPHISM ─────────────────────────────────────────────── */
QFrame#card_publicar {
    background-color: #18181B;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 18px;
}
QFrame#card_historial {
    background-color: #18181B;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 18px;
}

/* ── ACCENT LINE TOP CARD ───────────────────────────────────────────── */
QFrame#card_accent_pub,
QFrame#card_accent_hist {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0.00 rgba(255, 107, 0,   0),
        stop:0.30 rgba(255, 107, 0, 160),
        stop:0.50 rgba(255, 160, 0, 255),
        stop:0.70 rgba(255, 107, 0, 160),
        stop:1.00 rgba(255, 107, 0,   0)
    );
    min-height: 1px;
    max-height: 1px;
    border: none;
    border-radius: 0px;
}

/* ── TÍTULOS DE CARD ────────────────────────────────────────────────── */
QLabel#lbl_card_eyebrow,
QLabel#lbl_hist_eyebrow {
    color: #FF6B00;
    font-size: 9px;
    font-weight: 600;
    font-family: "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
    letter-spacing: 2px;
}
QLabel#lbl_card_titulo,
QLabel#lbl_hist_titulo {
    color: rgba(255, 255, 255, 0.92);
    font-size: 17px;
    font-weight: 600;
    font-family: "SF Pro Display", "Helvetica Neue", Arial, sans-serif;
    letter-spacing: -0.3px;
}
QLabel#lbl_card_desc,
QLabel#lbl_hist_desc {
    color: rgba(255, 255, 255, 0.35);
    font-size: 11px;
    font-weight: 400;
    font-family: "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
    letter-spacing: 0.1px;
}

/* ── ETIQUETAS CAMPO ────────────────────────────────────────────────── */
QLabel#lbl_f_titulo,
QLabel#lbl_f_cuerpo,
QLabel#lbl_f_tipo {
    color: rgba(255, 255, 255, 0.40);
    font-size: 10px;
    font-weight: 600;
    font-family: "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
    letter-spacing: 1.5px;
}

/* ── INPUT TITLE ────────────────────────────────────────────────────── */
QLineEdit#input_titulo {
    background-color: #222226;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    color: rgba(255, 255, 255, 0.88);
    padding: 11px 14px;
    font-size: 13px;
    font-weight: 400;
    font-family: "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
    min-height: 22px;
    selection-background-color: rgba(255, 107, 0, 0.30);
    selection-color: #FFFFFF;
}
QLineEdit#input_titulo:hover {
    background-color: #27272C;
    border: 1px solid rgba(255, 255, 255, 0.13);
}
QLineEdit#input_titulo:focus {
    background-color: #222226;
    border: 1px solid rgba(255, 107, 0, 0.60);
    color: #FFFFFF;
}

/* ── TEXTAREA CUERPO ────────────────────────────────────────────────── */
QTextEdit#input_cuerpo {
    background-color: #222226;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    color: rgba(255, 255, 255, 0.82);
    padding: 12px 14px;
    font-size: 13px;
    font-weight: 400;
    font-family: "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
    selection-background-color: rgba(255, 107, 0, 0.30);
    selection-color: #FFFFFF;
}
QTextEdit#input_cuerpo:hover {
    background-color: #27272C;
    border: 1px solid rgba(255, 255, 255, 0.13);
}
QTextEdit#input_cuerpo:focus {
    background-color: #222226;
    border: 1px solid rgba(255, 107, 0, 0.60);
    color: #FFFFFF;
}

/* ── CHECKBOX ───────────────────────────────────────────────────────── */
QCheckBox#chk_aviso {
    color: rgba(255, 255, 255, 0.55);
    font-size: 12px;
    font-weight: 400;
    font-family: "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
    letter-spacing: 0.1px;
    spacing: 9px;
}
QCheckBox#chk_aviso::indicator {
    width: 17px;
    height: 17px;
    border-radius: 5px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background-color: #222226;
}
QCheckBox#chk_aviso::indicator:hover {
    border: 1px solid rgba(255, 107, 0, 0.55);
    background-color: rgba(255, 107, 0, 0.08);
}
QCheckBox#chk_aviso::indicator:checked {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,
        stop:0 #FF6B00, stop:1 #FF3D00);
    border: 1px solid rgba(255, 150, 50, 0.50);
}

/* ── BOTÓN PUBLICAR (CTA primario) ──────────────────────────────────── */
QPushButton#btn_publicar {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0.0  #FF7A1A,
        stop:1.0  #FF5500
    );
    color: #FFFFFF;
    font-weight: 600;
    font-size: 12px;
    font-family: "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
    letter-spacing: 0.3px;
    border-radius: 10px;
    border: 1px solid rgba(255, 180, 80, 0.20);
    border-bottom: 1px solid rgba(150, 50, 0, 0.40);
    min-height: 42px;
    padding: 0 22px;
}
QPushButton#btn_publicar:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0.0  #FF8C2A,
        stop:1.0  #FF6600
    );
}
QPushButton#btn_publicar:pressed {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0.0  #E05800,
        stop:1.0  #CC4400
    );
    padding-top: 1px;
}

/* ── BOTÓN LIMPIAR (secundario) ─────────────────────────────────────── */
QPushButton#btn_limpiar {
    background-color: rgba(255, 255, 255, 0.05);
    color: rgba(255, 255, 255, 0.45);
    font-size: 12px;
    font-weight: 500;
    font-family: "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
    letter-spacing: 0.2px;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 10px;
    min-height: 42px;
    padding: 0 22px;
}
QPushButton#btn_limpiar:hover {
    background-color: rgba(255, 255, 255, 0.09);
    color: rgba(255, 255, 255, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.18);
}
QPushButton#btn_limpiar:pressed {
    background-color: rgba(255, 255, 255, 0.04);
}

/* ── IMAGEN DECORATIVA CARD PUBLICAR ────────────────────────────────── */
QLabel#lbl_pub_image {
    border-radius: 10px;
    qproperty-alignment: AlignCenter;
}

/* ── TABLA ──────────────────────────────────────────────────────────── */
QTableWidget#tabla_noticias {
    background: transparent;
    border: none;
    gridline-color: rgba(255, 255, 255, 0.04);
    color: rgba(255, 255, 255, 0.80);
    font-size: 12px;
    font-weight: 400;
    font-family: "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
    selection-background-color: rgba(255, 107, 0, 0.10);
    selection-color: rgba(255, 255, 255, 0.92);
    outline: none;
}
QTableWidget#tabla_noticias::item {
    padding: 11px 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
}
QTableWidget#tabla_noticias::item:selected {
    background-color: rgba(255, 107, 0, 0.08);
    color: rgba(255, 255, 255, 0.92);
    border-radius: 0px;
}
QTableWidget#tabla_noticias::item:hover {
    background-color: rgba(255, 255, 255, 0.03);
}
QHeaderView::section {
    background-color: transparent;
    color: rgba(255, 255, 255, 0.28);
    font-size: 10px;
    font-weight: 600;
    font-family: "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
    letter-spacing: 1.5px;
    padding: 10px 14px;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}
QHeaderView::section:first {
    border-top-left-radius: 0px;
}
QHeaderView::section:last {
    border-top-right-radius: 0px;
}

/* ── SCROLLBAR ──────────────────────────────────────────────────────── */
QScrollBar:vertical {
    background: transparent;
    width: 5px;
    border-radius: 3px;
    margin: 4px 0;
}
QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.14);
    border-radius: 3px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    background: rgba(255, 107, 0, 0.45);
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical { background: transparent; }

/* ── BADGE AVISO URGENTE ────────────────────────────────────────────── */
QLabel#lbl_badge_aviso {
    color: #FF6B00;
    background: rgba(255, 107, 0, 0.10);
    border: 1px solid rgba(255, 107, 0, 0.22);
    border-radius: 20px;
    font-size: 9px;
    font-weight: 600;
    font-family: "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
    letter-spacing: 1px;
    padding: 3px 10px;
}

/* ── SEPARADOR INTERNO ──────────────────────────────────────────────── */
QFrame#sep_card {
    background-color: rgba(255, 255, 255, 0.05);
    min-height: 1px;
    max-height: 1px;
    border: none;
}

/* ── PIE ────────────────────────────────────────────────────────────── */
QLabel#lbl_version {
    color: rgba(255, 255, 255, 0.10);
    font-size: 10px;
    font-weight: 400;
    font-family: "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
    letter-spacing: 1px;
    qproperty-alignment: AlignCenter;
}

   </string>
  </property>

  <widget class="QWidget" name="centralwidget">
   <layout class="QHBoxLayout" name="root_layout">
    <property name="spacing"><number>0</number></property>
    <property name="leftMargin"><number>0</number></property>
    <property name="topMargin"><number>0</number></property>
    <property name="rightMargin"><number>0</number></property>
    <property name="bottomMargin"><number>0</number></property>

    <!-- ══════════════════════════════════
         SIDEBAR — 220px fixed
         ══════════════════════════════════ -->
    <item>
     <widget class="QFrame" name="sidebar">
      <property name="minimumSize"><size><width>220</width><height>0</height></size></property>
      <property name="maximumSize"><size><width>220</width><height>16777215</height></size></property>
      <layout class="QVBoxLayout" name="vl_sidebar">
       <property name="spacing"><number>0</number></property>
       <property name="leftMargin"><number>0</number></property>
       <property name="topMargin"><number>0</number></property>
       <property name="rightMargin"><number>0</number></property>
       <property name="bottomMargin"><number>0</number></property>

       <!-- LOGO BLOQUE -->
       <item>
        <layout class="QVBoxLayout" name="vl_logo">
         <property name="leftMargin"><number>20</number></property>
         <property name="topMargin"><number>28</number></property>
         <property name="rightMargin"><number>20</number></property>
         <property name="bottomMargin"><number>24</number></property>
         <property name="spacing"><number>3</number></property>
         <item>
          <widget class="QLabel" name="lbl_sidebar_logo">
           <property name="text"><string>CRYPTOLEARNING</string></property>
          </widget>
         </item>
         <item>
          <widget class="QLabel" name="lbl_sidebar_sub">
           <property name="text"><string>Panel Analista</string></property>
          </widget>
         </item>
        </layout>
       </item>

       <!-- DIVISOR -->
       <item>
        <widget class="QFrame" name="sep_sidebar">
         <property name="frameShape"><enum>QFrame::HLine</enum></property>
         <property name="minimumSize"><size><width>0</width><height>1</height></size></property>
         <property name="maximumSize"><size><width>16777215</width><height>1</height></size></property>
        </widget>
       </item>

       <!-- NAVEGACIÓN -->
       <item>
        <layout class="QVBoxLayout" name="vl_nav">
         <property name="spacing"><number>2</number></property>
         <property name="leftMargin"><number>12</number></property>
         <property name="topMargin"><number>20</number></property>
         <property name="rightMargin"><number>12</number></property>
         <property name="bottomMargin"><number>0</number></property>

         <!-- Etiqueta sección -->
         <item>
          <widget class="QLabel" name="lbl_nav_section">
           <property name="text"><string>CONTENIDO</string></property>
           <property name="minimumSize"><size><width>0</width><height>24</height></size></property>
          </widget>
         </item>

         <item><spacer name="sp_nav_lbl"><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeType"><enum>QSizePolicy::Fixed</enum></property><property name="sizeHint" stdset="0"><size><width>0</width><height>4</height></size></property></spacer></item>

         <item>
          <widget class="QPushButton" name="btn_nav_noticias">
           <property name="cursor"><cursorShape>PointingHandCursor</cursorShape></property>
           <property name="text"><string>Publicar Noticia</string></property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="btn_nav_historial">
           <property name="cursor"><cursorShape>PointingHandCursor</cursorShape></property>
           <property name="text"><string>Historial</string></property>
          </widget>
         </item>
        </layout>
       </item>

       <!-- SPACER CRECER -->
       <item>
        <spacer name="sp_nav_grow">
         <property name="orientation"><enum>Qt::Vertical</enum></property>
         <property name="sizeType"><enum>QSizePolicy::Expanding</enum></property>
         <property name="sizeHint" stdset="0"><size><width>0</width><height>0</height></size></property>
        </spacer>
       </item>

       <!-- DIVISOR inferior -->
       <item>
        <widget class="QFrame" name="sep_sidebar_bot">
         <property name="objectName"><string>sep_sidebar</string></property>
         <property name="frameShape"><enum>QFrame::HLine</enum></property>
         <property name="minimumSize"><size><width>0</width><height>1</height></size></property>
         <property name="maximumSize"><size><width>16777215</width><height>1</height></size></property>
        </widget>
       </item>

       <!-- USER PILL -->
       <item>
        <layout class="QVBoxLayout" name="vl_user">
         <property name="leftMargin"><number>12</number></property>
         <property name="topMargin"><number>14</number></property>
         <property name="rightMargin"><number>12</number></property>
         <property name="bottomMargin"><number>14</number></property>
         <item>
          <widget class="QFrame" name="user_pill">
           <layout class="QHBoxLayout" name="hl_user_pill">
            <property name="leftMargin"><number>10</number></property>
            <property name="topMargin"><number>8</number></property>
            <property name="rightMargin"><number>10</number></property>
            <property name="bottomMargin"><number>8</number></property>
            <property name="spacing"><number>10</number></property>
            <item>
             <widget class="QLabel" name="lbl_user_avatar">
              <property name="text"><string>A</string></property>
              <property name="minimumSize"><size><width>30</width><height>30</height></size></property>
              <property name="maximumSize"><size><width>30</width><height>30</height></size></property>
             </widget>
            </item>
            <item>
             <layout class="QVBoxLayout" name="vl_user_info">
              <property name="spacing"><number>1</number></property>
              <item>
               <widget class="QLabel" name="lbl_user_name">
                <property name="text"><string>analista@unileon.es</string></property>
               </widget>
